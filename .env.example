# ==============================================================================
# Distributed File Sharing Platform — Environment Configuration Template
# Copy this file to .env before running docker compose. Never commit real secrets.
# ==============================================================================

# Application & Frontend Port Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FRONTEND_PORT=80

# Production Domain & SSL Configuration
# Domain: fileshare.sanketrajput.live
# HTTPS Port 443 is exposed via Docker Compose.
VITE_API_BASE_URL=/api/v1

# PostgreSQL Metadata Store (Docker container host 'postgres' or external DB host)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fileshare_db
POSTGRES_USER=fileshare_user
POSTGRES_PASSWORD=replace-with-strong-db-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fileshare_db

# MinIO S3-Compatible Object Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=change_me_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_secret_password
MINIO_BUCKET_NAME=fileshare-storage

# Redis Cache Store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_PORT=9092
# Set KAFKA_HOST to your EC2 Public IP / Elastic IP (or localhost for local dev)
KAFKA_HOST=replace-with-ec2-public-or-elastic-ip

# Security & JWT Authentication
# Generate a 256-bit secret key using: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-output
JWT_EXPIRATION_MS=86400000
