{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Request Latency (p95 & p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "http_server_requests_seconds_sum / http_server_requests_seconds_count",
          "legendFormat": "Avg Latency (s)"
        }
      ]
    },
    {
      "title": "Kafka Events Published & Consumed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "kafka_events_published_total",
          "legendFormat": "Events Published"
        },
        {
          "expr": "kafka_events_consumed_total",
          "legendFormat": "Events Consumed"
        }
      ]
    },
    {
      "title": "Deduplicated Uploads Count",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "file_upload_deduplicated_total",
          "legendFormat": "Deduplicated Uploads"
        }
      ]
    },
    {
      "title": "JVM Heap Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "Used Heap Bytes"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fileshare", "spring-boot"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Distributed File Sharing Platform Dashboard",
  "uid": "fileshare-metrics-v1"
